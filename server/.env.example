# ===== Servidor =====
PORT=4000
# URL pública onde o frontend é servido (usada para CORS e redirecionamentos)
APP_URL=http://localhost:5173
NODE_ENV=development
DATA_DIR=./data

# Chave mestra para criptografar tokens (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ===== Mercado Livre (https://developers.mercadolivre.com.br/devcenter) =====
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Deve ser IDÊNTICA à URL cadastrada no app do DevCenter (HTTPS obrigatório em produção)
ML_REDIRECT_URI=http://localhost:4000/api/ml/oauth/callback
ML_SITE_ID=MLB
ML_AUTH_HOST=https://auth.mercadolivre.com.br
# Intervalo da sincronização incremental automática (minutos)
SYNC_INTERVAL_MINUTES=15

# ===== Inteligência artificial (Anthropic) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ===== Backup =====
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
