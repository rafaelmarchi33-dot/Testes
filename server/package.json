{
  "name": "mli-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "backup": "node --disable-warning=ExperimentalWarning src/scripts/backup.ts",
    "create-admin": "node --disable-warning=ExperimentalWarning src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^7.0.2"
  }
}
